# The assistant's local secrets and configuration (may hold commands that
# were run, hence possibly IPs, credentials or keys of the cluster used
# during development): must never be published.
.claude/

# The real personal configuration (the versioned sample is config.yaml.example).
config.yaml

# Working notes (plans, progress), kept out of the repository.
/plans/

# Compiled binaries, whatever the output name or platform.
/termdevtools
/termdevtools.exe
/dist/

# Requests/results exported at run time (Ctrl+S, F2): local session data,
# never content to publish.
/exports/

# Crash reports (recoverCrash, main.go): a local diagnosis, which may hold
# execution details specific to the machine.
crash-*.log

# Standard Go artifacts.
*.test
*.out

# Editor- and OS-specific files.
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
