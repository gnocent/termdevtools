# Sample config.yaml — the real one lives in
# ~/.config/termdevtools/config.yaml and is created automatically on first
# launch (see SPEC.md §9.1-§9.2). Specific to each user: two people running
# the same shared binary don't share a connection history. No secret is ever
# stored in it: passwords, API key secrets and private key passphrases are
# always asked again on connection.

default_timeout_seconds: 120

# Interface language: "en" (default) or "fr". Optional.
language: en

# Mouse support (click to give the focus to a field or a list entry). Off by
# default: every mouse interaction has a full keyboard equivalent (SPEC.md
# §3-4), and leaving it off keeps the terminal's own selection and paste
# available (turning it on hands them to the application instead — F2
# copies the result either way). Optional.
mouse: false

# Directories used to pre-fill the certificate fields when entering a new
# connection (§3.0), and browsed by the certificate picker (Enter on the
# field) to list the files available. By default: the standard system-wide
# TLS certificate directory of RHEL/CentOS, on Linux only — empty ("", as
# below) on Windows and macOS, where that path doesn't exist. Leave them
# empty for no pre-filled path at all.
default_ca_dir: ""
default_client_cert_dir: ""

# The order of this list is the usage history: the most recently used
# cluster is automatically moved to the top (§9.2). This file is normally
# written and updated by the program after every successful connection —
# editing it by hand is possible, but optional.
#
# The distribution (Elasticsearch or OpenSearch) and version of a cluster
# are detected at every connection: they decide which recipes, endpoints and
# _cat columns are offered (§3.0). "distribution" and "version", both
# optional, only serve to replace that detection when it can't succeed — a
# proxy hiding the cluster, or an OpenSearch in compatibility mode, which
# reports a fake version. The program never writes them itself.
clusters:
  - url: https://es-prod.example.com:9200
    auth_type: basic # none | basic | api_key | mtls
    username: svc_devtools
    tls:
      verify: true
      ca_file: /etc/pki/ca-trust/es-prod-ca.pem

  - url: https://es-staging.example.com:9200
    auth_type: none
    tls:
      verify: false

  - url: https://search-behind-proxy.example.com
    auth_type: none
    distribution: opensearch # elasticsearch | opensearch
    version: "2.19"
    tls:
      verify: true
